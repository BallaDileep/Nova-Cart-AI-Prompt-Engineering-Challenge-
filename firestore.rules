rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function me() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; }
    function partner() { return request.auth != null && me().role == 'partner'; }
    match /users/{u} {
      allow read: if request.auth != null && request.auth.uid == u;
      allow create: if request.auth != null && request.auth.uid == u && request.resource.data.role == 'shopper';
    }
    match /products/{p} {
      allow read: if true;
      allow create: if partner() && request.resource.data.st == me().store;
      allow update: if (partner() && resource.data.st == me().store)
        || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['s'])
            && request.resource.data.s >= 0 && request.resource.data.s < resource.data.s);
    }
    match /orders/{o} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || (partner() && me().store in resource.data.stores));
      allow update: if partner() && me().store in resource.data.stores;
    }
    match /config/{d} { allow read: if true; allow write: if partner(); }
  }
}
